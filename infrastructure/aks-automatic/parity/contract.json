{
  "version": 1,
  "inputs": {
    "environment": "environment",
    "location": "location",
    "prefix": "naming.prefix",
    "adminGroupObjectId": "identity.adminGroupObjectId",
    "network": "network",
    "observability": "observability",
    "tags": "tags"
  },
  "operationalInputs": {
    "terraform": "Terraform-only backend lifecycle; excluded from environment resource parity",
    "local": "Shared readiness local target; not an Azure infrastructure input",
    "workload": "Shared readiness Helm/image lifecycle; independent of infrastructure engine"
  },
  "outputs": [
    "environment", "location", "resourceGroup", "cluster", "registry", "vault",
    "network", "identities", "monitoring", "readiness"
  ],
  "resourceTypes": {
    "azurerm_resource_group": "Microsoft.Resources/resourceGroups",
    "azurerm_virtual_network": "Microsoft.Network/virtualNetworks",
    "azurerm_subnet": "Microsoft.Network/virtualNetworks/subnets",
    "azurerm_user_assigned_identity": "Microsoft.ManagedIdentity/userAssignedIdentities",
    "azurerm_federated_identity_credential": "Microsoft.ManagedIdentity/userAssignedIdentities/federatedIdentityCredentials",
    "azurerm_role_assignment": "Microsoft.Authorization/roleAssignments",
    "azurerm_key_vault": "Microsoft.KeyVault/vaults",
    "azurerm_private_dns_zone": "Microsoft.Network/privateDnsZones",
    "azurerm_private_dns_zone_virtual_network_link": "Microsoft.Network/privateDnsZones/virtualNetworkLinks",
    "azurerm_private_endpoint": "Microsoft.Network/privateEndpoints",
    "azurerm_log_analytics_workspace": "Microsoft.OperationalInsights/workspaces",
    "azurerm_monitor_workspace": "Microsoft.Monitor/accounts",
    "azurerm_dashboard_grafana": "Microsoft.Dashboard/grafana",
    "azurerm_monitor_data_collection_rule": "Microsoft.Insights/dataCollectionRules",
    "azurerm_monitor_data_collection_rule_association": "Microsoft.Insights/dataCollectionRuleAssociations",
    "azurerm_monitor_diagnostic_setting": "Microsoft.Insights/diagnosticSettings",
    "azurerm_monitor_action_group": "Microsoft.Insights/actionGroups",
    "azurerm_monitor_activity_log_alert": "Microsoft.Insights/activityLogAlerts",
    "azurerm_monitor_alert_prometheus_rule_group": "Microsoft.AlertsManagement/prometheusRuleGroups",
    "azurerm_monitor_scheduled_query_rules_alert_v2": "Microsoft.Insights/scheduledQueryRules"
  },
  "inventory": {
    "Microsoft.Resources/resourceGroups": {"dev": 1, "production": 1},
    "Microsoft.Network/virtualNetworks": {"dev": 1, "production": 1},
    "Microsoft.Network/virtualNetworks/subnets": {"dev": 4, "production": 4},
    "Microsoft.ManagedIdentity/userAssignedIdentities": {"dev": 2, "production": 2},
    "Microsoft.ManagedIdentity/userAssignedIdentities/federatedIdentityCredentials": {"dev": 1, "production": 1},
    "Microsoft.Authorization/roleAssignments": {"dev": 5, "production": 8},
    "Microsoft.ContainerService/managedClusters": {"dev": 1, "production": 1},
    "Microsoft.ContainerRegistry/registries": {"dev": 1, "production": 1},
    "Microsoft.KeyVault/vaults": {"dev": 1, "production": 1},
    "Microsoft.KeyVault/vaults/keys": {"dev": 1, "production": 1},
    "Microsoft.Network/privateDnsZones": {"dev": 0, "production": 3},
    "Microsoft.Network/privateDnsZones/virtualNetworkLinks": {"dev": 0, "production": 3},
    "Microsoft.Network/privateEndpoints": {"dev": 0, "production": 2},
    "Microsoft.Network/privateEndpoints/privateDnsZoneGroups": {"dev": 0, "production": 2},
    "Microsoft.OperationalInsights/workspaces": {"dev": 1, "production": 1},
    "Microsoft.Monitor/accounts": {"dev": 0, "production": 1},
    "Microsoft.Dashboard/grafana": {"dev": 0, "production": 1},
    "Microsoft.Insights/dataCollectionRules": {"dev": 1, "production": 2},
    "Microsoft.Insights/dataCollectionRuleAssociations": {"dev": 1, "production": 2},
    "Microsoft.Insights/diagnosticSettings": {"dev": 1, "production": 1},
    "Microsoft.Insights/actionGroups": {"dev": 0, "production": 1},
    "Microsoft.Insights/activityLogAlerts": {"dev": 0, "production": 1},
    "Microsoft.AlertsManagement/prometheusRuleGroups": {"dev": 0, "production": 1},
    "Microsoft.Insights/scheduledQueryRules": {"dev": 0, "production": 1}
  },
  "roles": {
    "Azure Kubernetes Service Cluster User Role": "4abbcc35-e782-43d8-92c5-2d3f1bd2253f",
    "Azure Kubernetes Service RBAC Cluster Admin": "b1ff04bb-8a4e-4dc4-8eb5-8693973ce19b",
    "Network Contributor": "4d97b98b-1d4f-4787-a291-c67834d212e7",
    "Private DNS Zone Contributor": "b12aa53e-6015-4669-85d0-8515ebb3ae7f",
    "AcrPull": "7f951dda-4ed3-4680-a7ca-43fe172d538d",
    "Key Vault Reader": "21090545-7ca7-4776-b22c-e363652d74d2",
    "Grafana Admin": "22926164-76b3-42b3-bc55-97df8dab3e41",
    "Monitoring Reader": "43d0d8ad-25c7-4714-9337-8ba259a9fe05"
  },
  "bindings": [
    {"address": "azurerm_key_vault.readiness", "fields": {
      "rbac_authorization_enabled": true,
      "network_acls.0.default_action": "Deny",
      "network_acls.0.bypass": "None",
      "soft_delete_retention_days": 90,
      "purge_protection_enabled": {"mode": {"dev": false, "production": true}},
      "public_network_access_enabled": {"mode": {"dev": true, "production": false}},
      "network_acls.0.ip_rules": {"config": "network.paasAllowedIpRanges"}
    }},
    {"address": "azapi_resource.marker", "fields": {
      "body.properties": {"kty": "RSA", "keySize": 2048, "keyOps": ["verify"], "attributes": {"enabled": true, "exportable": false}},
      "parent_id": {"resource": "azurerm_key_vault.readiness", "path": "id"}
    }},
    {"address": "azurerm_federated_identity_credential.readiness", "fields": {
      "subject": "system:serviceaccount:aiks-readiness:readiness",
      "audience": ["api://AzureADTokenExchange"],
      "user_assigned_identity_id": {"resource": "azurerm_user_assigned_identity.identity[\"readiness\"]", "path": "id"},
      "issuer": "https://issuer.example.invalid/"
    }},
    {"address": "azurerm_role_assignment.cluster_admin[\"Azure Kubernetes Service Cluster User Role\"]", "fields": {
      "role_definition_name": "Azure Kubernetes Service Cluster User Role", "principal_type": "Group",
      "principal_id": {"config": "identity.adminGroupObjectId"}, "scope": {"output": "cluster.id"}
    }},
    {"address": "azurerm_role_assignment.cluster_admin[\"Azure Kubernetes Service RBAC Cluster Admin\"]", "fields": {
      "role_definition_name": "Azure Kubernetes Service RBAC Cluster Admin", "principal_type": "Group",
      "principal_id": {"config": "identity.adminGroupObjectId"}, "scope": {"output": "cluster.id"}
    }},
    {"address": "azurerm_role_assignment.network", "fields": {
      "role_definition_name": "Network Contributor", "principal_type": "ServicePrincipal",
      "principal_id": {"resource": "azurerm_user_assigned_identity.identity[\"cluster\"]", "path": "principal_id"},
      "scope": {"resource": "azurerm_virtual_network.environment", "path": "id"}
    }},
    {"address": "azurerm_role_assignment.dns[0]", "environments": ["production"], "fields": {
      "role_definition_name": "Private DNS Zone Contributor", "principal_type": "ServicePrincipal",
      "principal_id": {"resource": "azurerm_user_assigned_identity.identity[\"cluster\"]", "path": "principal_id"},
      "scope": {"resource": "azurerm_private_dns_zone.api[0]", "path": "id"}
    }},
    {"address": "azurerm_role_assignment.pull", "fields": {
      "role_definition_name": "AcrPull", "principal_type": "ServicePrincipal",
      "principal_id": "33333333-3333-4333-8333-333333333333", "scope": {"output": "registry.id"}
    }},
    {"address": "azurerm_role_assignment.vault_reader", "fields": {
      "role_definition_name": "Key Vault Reader", "principal_type": "ServicePrincipal",
      "principal_id": {"resource": "azurerm_user_assigned_identity.identity[\"readiness\"]", "path": "principal_id"},
      "scope": {"resource": "azurerm_key_vault.readiness", "path": "id"}
    }},
    {"address": "azurerm_role_assignment.grafana_admin[0]", "environments": ["production"], "fields": {
      "role_definition_name": "Grafana Admin", "principal_type": "Group",
      "principal_id": {"config": "identity.adminGroupObjectId"},
      "scope": {"resource": "azurerm_dashboard_grafana.dashboard[0]", "path": "id"}
    }},
    {"address": "azurerm_role_assignment.grafana_reader[0]", "environments": ["production"], "fields": {
      "role_definition_name": "Monitoring Reader", "principal_type": "ServicePrincipal",
      "principal_id": {"resource": "azurerm_dashboard_grafana.dashboard[0]", "path": "identity.0.principal_id"},
      "scope": {"resource": "azurerm_monitor_workspace.metrics[0]", "path": "id"}
    }},
    {"address": "azurerm_log_analytics_workspace.logs[0]", "fields": {
      "local_authentication_enabled": false, "sku": "PerGB2018",
      "retention_in_days": {"config": "observability.logRetentionDays"}
    }},
    {"address": "azurerm_dashboard_grafana.dashboard[0]", "environments": ["production"], "fields": {
      "grafana_major_version": "12", "api_key_enabled": false,
      "deterministic_outbound_ip_enabled": true, "zone_redundancy_enabled": true,
      "identity.0.type": "SystemAssigned",
      "azure_monitor_workspace_integrations.0.resource_id": {"resource": "azurerm_monitor_workspace.metrics[0]", "path": "id"}
    }},
    {"address": "azurerm_monitor_data_collection_rule.containers[0]", "fields": {
      "data_flow.0.streams": ["Microsoft-ContainerInsights-Group-Default"], "data_flow.0.destinations": ["logs"],
      "data_sources.0.extension.0.extension_name": "ContainerInsights",
      "destinations.0.log_analytics.0.workspace_resource_id": {"resource": "azurerm_log_analytics_workspace.logs[0]", "path": "id"}
    }},
    {"address": "azurerm_monitor_data_collection_rule.prometheus[0]", "environments": ["production"], "fields": {
      "data_flow.0.streams": ["Microsoft-PrometheusMetrics"], "data_flow.0.destinations": ["metrics"],
      "data_sources.0.prometheus_forwarder.0.streams": ["Microsoft-PrometheusMetrics"],
      "destinations.0.monitor_account.0.monitor_account_id": {"resource": "azurerm_monitor_workspace.metrics[0]", "path": "id"},
      "data_collection_endpoint_id": {"resource": "azurerm_monitor_workspace.metrics[0]", "path": "default_data_collection_endpoint_id"}
    }},
    {"address": "azurerm_monitor_data_collection_rule_association.containers[0]", "fields": {
      "target_resource_id": {"output": "cluster.id"},
      "data_collection_rule_id": {"resource": "azurerm_monitor_data_collection_rule.containers[0]", "path": "id"}
    }},
    {"address": "azurerm_monitor_data_collection_rule_association.prometheus[0]", "environments": ["production"], "fields": {
      "target_resource_id": {"output": "cluster.id"},
      "data_collection_rule_id": {"resource": "azurerm_monitor_data_collection_rule.prometheus[0]", "path": "id"}
    }},
    {"address": "azurerm_monitor_diagnostic_setting.cluster[0]", "fields": {
      "target_resource_id": {"output": "cluster.id"},
      "log_analytics_workspace_id": {"resource": "azurerm_log_analytics_workspace.logs[0]", "path": "id"},
      "name": "service", "enabled_metric.0.category": "AllMetrics"
    }},
    {"address": "azurerm_monitor_alert_prometheus_rule_group.signals[0]", "environments": ["production"], "fields": {
      "interval": "PT1M", "cluster_name": {"output": "cluster.name"}
    }},
    {"address": "azurerm_monitor_scheduled_query_rules_alert_v2.pipeline[0]", "environments": ["production"], "fields": {
      "criteria.0.operator": "LessThan", "criteria.0.threshold": 1, "criteria.0.time_aggregation_method": "Count",
      "window_duration": "PT15M", "evaluation_frequency": "PT5M", "severity": 2, "auto_mitigation_enabled": true
    }},
    {"address": "azurerm_monitor_activity_log_alert.health[0]", "environments": ["production"], "fields": {
      "criteria.0.category": "ResourceHealth"
    }}
  ],
  "resources": [
    {
      "id": "cluster",
      "bicepModules": ["foundation", "cluster"],
      "type": "Microsoft.ContainerService/managedClusters",
      "apiVersion": "2026-04-01",
      "terraformAddress": "azapi_resource.cluster",
      "equal": {
        "sku": {"name": "Automatic", "tier": "Standard"},
        "properties.enableRBAC": true,
        "properties.disableLocalAccounts": true,
        "properties.aadProfile": {"managed": true, "enableAzureRBAC": true},
        "properties.nodeProvisioningProfile": {"mode": "Auto", "defaultNodePools": "Auto"},
        "properties.networkProfile.networkPlugin": "azure",
        "properties.networkProfile.networkPluginMode": "overlay",
        "properties.networkProfile.networkDataplane": "cilium",
        "properties.networkProfile.networkPolicy": "cilium",
        "properties.networkProfile.loadBalancerSku": "standard",
        "properties.oidcIssuerProfile": {"enabled": true},
        "properties.securityProfile": {"workloadIdentity": {"enabled": true}},
        "properties.autoUpgradeProfile": {"upgradeChannel": "stable", "nodeOSUpgradeChannel": "NodeImage"},
        "properties.ingressProfile": {
          "gatewayAPI": {"installation": "Standard"},
          "webAppRouting": {
            "enabled": true,
            "nginx": {"defaultIngressControllerType": "None"},
            "gatewayAPIImplementations": {"appRoutingIstio": {"mode": "Enabled"}}
          }
        },
        "properties.addonProfiles.azurepolicy": {"enabled": true}
      },
      "absent": ["properties.serviceMeshProfile"],
      "configured": {
        "properties.networkProfile.podCidr": "network.podCidr",
        "properties.networkProfile.serviceCidr": "network.serviceCidr",
        "properties.networkProfile.dnsServiceIP": "network.dnsServiceIp",
        "properties.addonProfiles.omsagent.enabled": "observability.containerInsights",
        "properties.azureMonitorProfile.metrics.enabled": "observability.managedPrometheus"
      }
    },
    {
      "id": "registry",
      "bicepModules": ["foundation", "registry"],
      "type": "Microsoft.ContainerRegistry/registries",
      "apiVersion": "2026-03-01-preview",
      "terraformAddress": "azapi_resource.registry",
      "equal": {
        "sku.name": "Premium",
        "properties.adminUserEnabled": false,
        "properties.anonymousPullEnabled": false,
        "properties.roleAssignmentMode": "LegacyRegistryPermissions",
        "properties.networkRuleBypassOptions": "None",
        "properties.dataEndpointEnabled": true,
        "properties.networkRuleSet.defaultAction": "Deny"
      },
      "absent": [],
      "configured": {}
    }
  ]
}